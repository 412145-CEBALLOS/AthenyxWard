# AthenyxWard - Environment Template
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/athenyx_ward?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Google OAuth2
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
OAUTH2_REDIRECT_URI=http://localhost:4200/login/oauth2/code/google

# JWT (use a long random base64 string)
JWT_SECRET=replace_with_long_random_base64_string
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
JWT_REFRESH_ABSOLUTE_EXPIRATION_MS=7776000000

# Refresh token cookie
AUTH_REFRESH_COOKIE_NAME=athenyx_refresh
AUTH_REFRESH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200

# Spring AI - Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_ENABLED=true
